+namespace RotationSolver.UI;
+
+/// <summary>
+/// Teal accent colors for the settings window, marking this build as a fork of RotationSolverReborn.
+/// </summary>
+public partial class RotationConfigWindow
+{
+	private static readonly (ImGuiCol Col, Vector4 Color)[] _brandColors =
+	[
+		(ImGuiCol.TitleBg, new Vector4(0.05f, 0.25f, 0.23f, 1f)),
+		(ImGuiCol.TitleBgActive, new Vector4(0.08f, 0.42f, 0.39f, 1f)),
+		(ImGuiCol.TitleBgCollapsed, new Vector4(0.05f, 0.25f, 0.23f, 0.75f)),
+		(ImGuiCol.Header, new Vector4(0.10f, 0.50f, 0.46f, 0.45f)),
+		(ImGuiCol.HeaderHovered, new Vector4(0.12f, 0.60f, 0.55f, 0.75f)),
+		(ImGuiCol.HeaderActive, new Vector4(0.14f, 0.68f, 0.62f, 1f)),
+		(ImGuiCol.Button, new Vector4(0.10f, 0.50f, 0.46f, 0.55f)),
+		(ImGuiCol.ButtonHovered, new Vector4(0.12f, 0.60f, 0.55f, 0.85f)),
+		(ImGuiCol.ButtonActive, new Vector4(0.14f, 0.68f, 0.62f, 1f)),
+		(ImGuiCol.FrameBgHovered, new Vector4(0.10f, 0.50f, 0.46f, 0.35f)),
+		(ImGuiCol.FrameBgActive, new Vector4(0.12f, 0.60f, 0.55f, 0.55f)),
+		(ImGuiCol.CheckMark, new Vector4(0.25f, 0.85f, 0.78f, 1f)),
+		(ImGuiCol.SliderGrab, new Vector4(0.18f, 0.72f, 0.66f, 1f)),
+		(ImGuiCol.SliderGrabActive, new Vector4(0.25f, 0.85f, 0.78f, 1f)),
+		(ImGuiCol.Separator, new Vector4(0.10f, 0.50f, 0.46f, 0.6f)),
+		(ImGuiCol.ResizeGrip, new Vector4(0.10f, 0.50f, 0.46f, 0.3f)),
+		(ImGuiCol.ResizeGripHovered, new Vector4(0.12f, 0.60f, 0.55f, 0.7f)),
+		(ImGuiCol.ResizeGripActive, new Vector4(0.14f, 0.68f, 0.62f, 1f)),
+	];
+
+	public override void PreDraw()
+	{
+		foreach (var (col, color) in _brandColors)
+		{
+			ImGui.PushStyleColor(col, color);
+		}
+		base.PreDraw();
+	}
+
+	public override void PostDraw()
+	{
+		ImGui.PopStyleColor(_brandColors.Length);
+		base.PostDraw();
+	}
+}
